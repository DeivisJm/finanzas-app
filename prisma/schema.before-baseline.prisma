generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectType {
  STANDARD
  TRIP
}

enum CurrencyLotSourceType {
  FUNDING
  CONVERSION
}

model Project {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  description String?
  color       String
  icon        String
  type        ProjectType @default(STANDARD)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  folders     Folder[]

  @@index([type])
}

model Folder {
  id           Int           @id @default(autoincrement())
  name         String
  slug         String
  color        String
  icon         String
  projectId    Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  expenses     Expense[]
  tripSettings TripSettings?
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, slug])
  @@index([projectId])
}

model Expense {
  id          Int       @id @default(autoincrement())
  description String
  amount      Int
  folderId    Int
  createdAt   DateTime  @default(now())
  expenseDate DateTime  @default(now())
  isPaid      Boolean   @default(false)
  paidAt      DateTime?
  updatedAt   DateTime  @updatedAt
  folder      Folder    @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([folderId, isPaid])
}

/**
 * Stores the financial configuration for a travel folder.
 * Each travel folder has exactly one base currency.
 */
model TripSettings {
  id               Int                   @id @default(autoincrement())
  folderId         Int                   @unique
  baseCurrencyCode String                @db.VarChar(3)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  folder           Folder                @relation(fields: [folderId], references: [id], onDelete: Cascade)
  accounts         TripCurrencyAccount[]
  fundings         TripFunding[]
  conversions      CurrencyConversion[]
  expenses         TripExpense[]

  @@index([baseCurrencyCode])
}

/**
 * Represents the current available balance for one currency
 * inside a travel folder.
 */
model TripCurrencyAccount {
  id                  Int                  @id @default(autoincrement())
  tripSettingsId      Int
  currencyCode        String               @db.VarChar(3)
  currentBalance      Decimal              @default(0) @db.Decimal(20, 4)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tripSettings        TripSettings         @relation(fields: [tripSettingsId], references: [id], onDelete: Cascade)
  fundings            TripFunding[]
  outgoingConversions CurrencyConversion[] @relation("OutgoingConversionAccount")
  incomingConversions CurrencyConversion[] @relation("IncomingConversionAccount")
  expenses            TripExpense[]
  lots                CurrencyLot[]

  @@unique([tripSettingsId, currencyCode])
  @@index([tripSettingsId])
  @@index([currencyCode])
}

/**
 * Adds money to a travel account without requiring a previous
 * conversion. It is commonly used to register the initial budget.
 */
model TripFunding {
  id             Int                 @id @default(autoincrement())
  tripSettingsId Int
  accountId      Int
  amount         Decimal             @db.Decimal(20, 4)
  note           String?
  fundingDate    DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  tripSettings   TripSettings        @relation(fields: [tripSettingsId], references: [id], onDelete: Cascade)
  account        TripCurrencyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lot            CurrencyLot?

  @@index([tripSettingsId])
  @@index([accountId])
  @@index([fundingDate])
}

/**
 * Records a manual currency conversion using the amounts
 * actually delivered and received by the user.
 */
model CurrencyConversion {
  id                Int                            @id @default(autoincrement())
  tripSettingsId    Int
  fromAccountId     Int
  toAccountId       Int
  fromAmount        Decimal                        @db.Decimal(20, 4)
  toAmount          Decimal                        @db.Decimal(20, 4)
  effectiveRate     Decimal                        @db.Decimal(24, 10)
  feeAmount         Decimal?                       @db.Decimal(20, 4)
  note              String?
  conversionDate    DateTime                       @default(now())
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  tripSettings      TripSettings                   @relation(fields: [tripSettingsId], references: [id], onDelete: Cascade)
  fromAccount       TripCurrencyAccount            @relation("OutgoingConversionAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount         TripCurrencyAccount            @relation("IncomingConversionAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  sourceAllocations CurrencyConversionAllocation[]
  destinationLot    CurrencyLot?

  @@index([tripSettingsId])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([conversionDate])
}

/**
 * Represents a traceable amount of money received from either
 * an initial funding operation or a currency conversion.
 */
model CurrencyLot {
  id                     Int                            @id @default(autoincrement())
  accountId              Int
  sourceType             CurrencyLotSourceType
  fundingId              Int?                           @unique
  conversionId           Int?                           @unique
  originalAmount         Decimal                        @db.Decimal(20, 4)
  remainingAmount        Decimal                        @db.Decimal(20, 4)
  unitCostInBaseCurrency Decimal                        @db.Decimal(24, 10)
  createdAt              DateTime                       @default(now())
  account                TripCurrencyAccount            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  funding                TripFunding?                   @relation(fields: [fundingId], references: [id], onDelete: Cascade)
  conversion             CurrencyConversion?            @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  conversionAllocations  CurrencyConversionAllocation[]
  expenseAllocations     TripExpenseAllocation[]

  @@index([accountId, remainingAmount])
  @@index([accountId, createdAt])
  @@index([sourceType])
}

/**
 * Tracks which source currency lots were consumed by a conversion.
 * These records allow chained conversions to preserve their
 * original cost in the trip's base currency.
 */
model CurrencyConversionAllocation {
  id                  Int                @id @default(autoincrement())
  conversionId        Int
  sourceLotId         Int
  allocatedAmount     Decimal            @db.Decimal(20, 4)
  allocatedBaseAmount Decimal            @db.Decimal(20, 4)
  createdAt           DateTime           @default(now())
  conversion          CurrencyConversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  sourceLot           CurrencyLot        @relation(fields: [sourceLotId], references: [id], onDelete: Restrict)

  @@unique([conversionId, sourceLotId])
  @@index([conversionId])
  @@index([sourceLotId])
}

/**
 * Records a purchase or expense made during a trip.
 */
model TripExpense {
  id                   Int                     @id @default(autoincrement())
  tripSettingsId       Int
  accountId            Int
  description          String
  category             String
  currencyCode         String                  @db.VarChar(3)
  amount               Decimal                 @db.Decimal(20, 4)
  equivalentBaseAmount Decimal                 @db.Decimal(20, 4)
  expenseDate          DateTime                @default(now())
  note                 String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  tripSettings         TripSettings            @relation(fields: [tripSettingsId], references: [id], onDelete: Cascade)
  account              TripCurrencyAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  allocations          TripExpenseAllocation[]

  @@index([tripSettingsId])
  @@index([accountId])
  @@index([currencyCode])
  @@index([expenseDate])
}

/**
 * Tracks the exact currency lots consumed by a travel expense.
 * Allocations are created in FIFO order.
 */
model TripExpenseAllocation {
  id                  Int         @id @default(autoincrement())
  tripExpenseId       Int
  sourceLotId         Int
  allocatedAmount     Decimal     @db.Decimal(20, 4)
  allocatedBaseAmount Decimal     @db.Decimal(20, 4)
  createdAt           DateTime    @default(now())
  tripExpense         TripExpense @relation(fields: [tripExpenseId], references: [id], onDelete: Cascade)
  sourceLot           CurrencyLot @relation(fields: [sourceLotId], references: [id], onDelete: Restrict)

  @@unique([tripExpenseId, sourceLotId])
  @@index([tripExpenseId])
  @@index([sourceLotId])
}
